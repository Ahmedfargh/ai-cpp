        <!-- TITLE BLOCK (PURE C++ NATIVE, ZERO DEPENDENCY / ZERO OLLAMA) -->
        <mxCell id="title" value="&lt;b style='font-size:22px; color:#000000; letter-spacing:1px;'&gt;THE NULL — 100% FROM-SCRATCH C++ ARCHITECTURE&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#333333; font-size:12px;'&gt;Zero Ollama • Zero Daemons • Standalone Binary: Native C++ LLM Engine + 1,000 Fractional Heterogeneous Specialists&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="1000" height="65" as="geometry" />
        </mxCell>

        <!-- ZONE 1: USER / COMMAND INTERFACE -->
