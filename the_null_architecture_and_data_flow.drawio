        <mxCell id="node_cli" value="&lt;b style='color:#000000;'&gt;THE NULL CLI &amp;amp; REPL&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#333333; font-size:11px;'&gt;Native C++ interactive terminal&lt;br/&gt;Direct binary invocation (No background daemon)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="zone_user">
          <mxGeometry x="50" y="210" width="200" height="70" as="geometry" />
