        <!-- ZONE 2: COMMANDER CORE (EMBEDDED NATIVE C++ LLM ENGINE) -->
        <mxCell id="zone_commander" value="&lt;b style='color:#000000;'&gt;2. COMMANDER — NATIVE C++ CENTRAL LLM (FROM SCRATCH)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;startSize=28;rounded=0;" vertex="1" parent="1">
