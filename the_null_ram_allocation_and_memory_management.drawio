        <mxCell id="title" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;align=center;" value="&lt;b style=&#39;font-size:18px; color:#000000;&#39;&gt;THE NULL — LRU MODEL VECTOR &amp;amp; CLEANER THREAD ENGINE&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;color:#333333; font-size:11px;&#39;&gt;Active Model Tracking List + Dedicated Background Cleaner Thread for Automatic RAM Eviction&lt;/span&gt;" vertex="1">
