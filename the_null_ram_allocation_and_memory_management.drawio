        <mxCell id="bar_arena" parent="zone_ram_budget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=10;" value="&lt;b&gt;DYNAMIC LRU MODEL ARENA&lt;/b&gt;&lt;br/&gt;~2.5 GB Governed by LRU Vector" vertex="1">
          <mxGeometry height="42" width="260" x="495" y="30" as="geometry" />
        </mxCell>
        <mxCell id="bar_army" parent="zone_ram_budget" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=10;" value="&lt;b&gt;1,000 AGENTS METADATA&lt;/b&gt;&lt;br/&gt;~15 MB (Zero inactive weights)" vertex="1">
          <mxGeometry height="42" width="200" x="765" y="30" as="geometry" />
